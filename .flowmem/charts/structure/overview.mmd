%%{init: {'theme': 'default', 'themeVariables': {'primaryColor': '#2563eb', 'primaryTextColor': '#ffffff', 'primaryBorderColor': '#1d4ed8', 'lineColor': '#64748b', 'secondaryColor': '#eff6ff', 'tertiaryColor': '#f0fdf4'}}}%%
%% FlowMem | type=flowchart | layer=structure | method=ai | refresh=none | last-updated=2026-05-03 %%
flowchart TD
    dev(["👤 Developer / AI Engineer"])

    subgraph skill["⚡ FlowMem Skill  —  Claude Code"]
        direction TB
        scan["📊 Phase 1 · Scan\nRun scripts + AI reasoning"]
        chart["🗺️ Phase 2 · Chart\nGenerate .mmd files by layer"]
        view["🌐 Phase 3 · View\nOpen index.html in browser"]
        scan --> chart --> view
    end

    subgraph mem[".flowmem/  output directory"]
        direction LR
        s["structure/\nmodules · classes"]
        b["behavior/\nsequences · states"]
        d["data/\nschema · ER"]
        p["project/\nroadmap · gantt"]
        q["quality/\ndebt · coverage"]
    end

    claude(["🤖 Any AI Assistant\nClaude · Cursor · Copilot · Windsurf"])

    dev -->|"say: generate flowmem"| skill
    chart -->|"writes .mmd files"| mem
    mem -->|"reads INDEX.md + charts"| claude
    dev <-->|"ask questions"| claude

    classDef primary fill:#2563eb,stroke:#1d4ed8,color:#fff,rx:8
    classDef memory fill:#eff6ff,stroke:#93c5fd,color:#1e40af
    classDef ai fill:#f0fdf4,stroke:#86efac,color:#166534
    class skill primary
    class s,b,d,p,q memory
    class claude ai
